# development | production | test. Obligatoria: sin ella la app no arranca.
NODE_ENV=development

# Conexión que usa la app en tiempo de ejecución.
# Local: Postgres de docker-compose. Supabase: "Transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://opinai:opinai@localhost:5433/opinai"

# Conexión que usa la CLI de Prisma para migraciones.
# Local: la misma. Supabase: "Session pooler" (puerto 5432, compatible con IPv4).
DIRECT_URL="postgresql://opinai:opinai@localhost:5433/opinai"

PORT=3000

# Orígenes de confianza (CORS y CSRF), separados por comas. Obligatoria en producción.
CORS_ORIGINS=http://localhost:5173

# Cookie de sesión solo por HTTPS. Si no se define: true en producción.
# COOKIE_SECURE=false

# Proxies delante de la app para obtener la IP real (Render: 1).
# Mal configurado rompe el rate limit: verificar al desplegar.
TRUST_PROXY=0

# TMDB (películas y series): "API Read Access Token" de
# https://www.themoviedb.org/settings/api. Opcional; nunca lo subas al repo.
TMDB_ACCESS_TOKEN=
